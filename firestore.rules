
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares seguras
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return request.auth != null && getUserData().get('role', '') == role;
    }
    
    function belongsToStore(storeId) {
      let data = getUserData();
      return data.get('role', '') == 'Master' || data.get('storeId', '') == storeId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if isRole('Master');
      allow delete: if isRole('Master') || (request.auth.uid == userId && getUserData().get('role', '') != 'Master');
    }
    
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isRole('Master');
    }

    match /ingredients/{ingredientId} {
        allow read: if belongsToStore(resource.data.storeId);
        allow create: if isRole('Master') || isRole('Gerente');
        allow update: if isRole('Master') || (isRole('Gerente') && belongsToStore(resource.data.storeId));
        allow delete: if isRole('Master');
    }

    match /suppliers/{supplierId} {
        allow read: if belongsToStore(resource.data.storeId);
        allow create, update, delete: if isRole('Master') || isRole('Gerente');
    }

    match /purchases/{purchaseId} {
       allow read: if belongsToStore(resource.data.storeId);
       allow create, update, delete: if isRole('Master') || isRole('Gerente');
    }

    match /expenses/{expenseId} {
       allow read: if belongsToStore(resource.data.storeId);
       allow create, update, delete: if isRole('Master') || isRole('Gerente');
    }
    
    match /stockAdjustments/{adjustmentId} {
      allow read: if belongsToStore(resource.data.storeId);
      allow create: if request.auth != null;
    }
    
    match /recipes/{recipeId} {
       allow read: if belongsToStore(resource.data.storeId);
       allow create, update, delete: if isRole('Master') || isRole('Gerente');
    }
    
    match /revenues/{revenueId} {
        allow read: if belongsToStore(resource.data.storeId);
        allow create, delete: if isRole('Master') || isRole('Gerente');
    }
    
    match /payableAccounts/{accountId} {
       allow read: if belongsToStore(resource.data.storeId);
       allow create, update, delete: if isRole('Master') || isRole('Gerente');
    }
    
    match /monthlyClosings/{closingId} {
        allow read: if belongsToStore(resource.data.storeId);
        allow create, update, delete: if isRole('Master') || isRole('Gerente');
    }
    
    match /settings/{settingsId} {
       allow read: if belongsToStore(resource.data.storeId);
       allow write: if isRole('Master') || isRole('Gerente');
    }

    match /checklists/{checklistId} {
      allow read: if belongsToStore(resource.data.storeId);
      allow write: if isRole('Master') || isRole('Gerente');
    }

    match /checklistExecutions/{executionId} {
      allow read: if belongsToStore(resource.data.storeId);
      allow create: if request.auth != null;
    }

    match /manuals/{manualId} {
      allow read: if belongsToStore(resource.data.storeId);
      allow write: if isRole('Master') || isRole('Gerente');
    }
  }
}
